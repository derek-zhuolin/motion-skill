{
  "name": "motion-skill",
  "private": true,
  "scripts": {
    "check": "npm --prefix examples/voice-to-video run check",
    "build": "npm --prefix examples/voice-to-video run build",
    "verify:frames": "npm --prefix examples/voice-to-video run verify:frames",
    "verify:rules": "python3 scripts/self_check.py",
    "verify:privacy": "python3 scripts/privacy_check.py",
    "verify:template": "python3 scripts/verify_template.py",
    "gallery": "esbuild scripts/gallery.tsx --bundle --platform=node --outfile=.cache/gallery.cjs && node .cache/gallery.cjs",
    "preview": "python3 examples/voice-to-video/serve.py --port 4341",
    "render": "npm --prefix examples/voice-to-video run render"
  },
  "dependencies": {
    "remotion": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.7",
    "esbuild": "0.28.1"
  },
  "version": "1.1.0-beta.1",
  "engines": {
    "node": ">=22"
  }
}