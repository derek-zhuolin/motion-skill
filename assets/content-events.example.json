    },
    "feedback": {
      "initial": "absent"
    }
  },
  "events": [
    {
      "id": "text",
      "at": 0,
      "end": 0.5,
      "object": "headline",
      "before": "absent",
      "after": "plain",
      "action": "reveal",
      "meaning": "The topic becomes readable",
      "focus": "headline",
      "source_refs": [
        "brief"
      ],
      "readable": [
        0.5,
        2
      ]
    },
    {
      "id": "join",
      "at": 1,
      "end": 1.4,
      "object": "character",
      "before": "absent",
      "after": "character-a",
      "action": "reveal",
      "meaning": "A character joins the existing content",
      "focus": "character",
      "source_refs": [
        "brief"
      ]
    },
    {
      "id": "emphasis",
      "at": 2,
      "end": 2.4,
      "object": "headline",
      "before": "plain",
      "after": "highlighted",
      "action": "emphasize",
      "meaning": "The important phrase is distinguished",
      "focus": "headline",
      "source_refs": [
        "brief"
      ]
    },
    {
      "id": "feedback",
      "at": 2.7,
      "end": 3,
      "object": "feedback",
      "before": "absent",
