    {
      "id": "read",
      "at": 3,
      "end": 5,
      "object": "headline",
      "before": "highlighted",
      "after": "highlighted",
      "action": "hold",
      "meaning": "Read the result",
      "focus": "headline",
      "source_refs": [
        "brief"
