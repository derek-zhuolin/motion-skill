    {
      "id": "replace",
      "at": 5,
      "end": 5.5,
      "object": "character",
      "before": "character-a",
      "after": "character-b",
      "action": "replace",
      "meaning": "Only the character changes; content remains",
      "focus": "character",
      "source_refs": [
        "brief"
      ]
    },
    {
      "id": "settle",
      "at": 5.5,
      "end": 10,
      "object": "headline",
      "before": "highlighted",
      "after": "highlighted",
      "action": "hold",
      "meaning": "Keep the completed result visible",
      "focus": "headline",
      "source_refs": [
